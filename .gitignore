# .gitignore
# =====================================================
# Archivos y carpetas a ignorar en git
# =====================================================

# Node modules
node_modules/
package-lock.json

# Archivos del sistema
.DS_Store
Thumbs.db
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos temporales
*.tmp
*.temp
.cache/

# Build outputs
dist/
build/
